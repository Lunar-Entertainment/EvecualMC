{
  "multipart": [
    {
      "apply": { "model": "evecualmc:block/wire_core" }
    },
    {
      "when": { "north": "true" },
      "apply": { "model": "evecualmc:block/wire_side" }
    },
    {
      "when": { "south": "true" },
      "apply": { "model": "evecualmc:block/wire_side", "y": 180 }
    },
    {
      "when": { "west": "true" },
      "apply": { "model": "evecualmc:block/wire_side", "y": 270 }
    },
    {
      "when": { "east": "true" },
      "apply": { "model": "evecualmc:block/wire_side", "y": 90 }
    },
    {
      "when": { "up": "true" },
      "apply": { "model": "evecualmc:block/wire_up" }
    },
    {
      "when": { "down": "true" },
      "apply": { "model": "evecualmc:block/wire_down" }
    }
  ]
}
